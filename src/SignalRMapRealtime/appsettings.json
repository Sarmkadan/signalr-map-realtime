{
  "ConnectionStrings": {
    "DefaultConnection": "Server=(localdb)\\mssqllocaldb;Database=SignalRMapRealtimeDb;Trusted_Connection=true;MultipleActiveResultSets=true"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "SignalRMapRealtime": "Information"
    },
    "Console": {
      "IncludeScopes": true,
      "Format": "json"
    }
  },
  "AllowedHosts": "*",

  "AppSettings": {
    "ApiVersion": "1.0.0",
    "ApiTitle": "SignalR Map Realtime API",
    "Environment": "Production",
    "EnableSwagger": true,
    "EnableCors": true,
    "RequestTimeoutSeconds": 30,
    "LocationUpdateIntervalSeconds": 30
  },

  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000",
      "http://localhost:5173",
      "http://localhost:8080"
    ]
  },

  "LocationThrottle": {
    "Enabled": true,
    "DeliveryVanIntervalSeconds": 1,
    "CourierIntervalSeconds": 10,
    "BicycleIntervalSeconds": 15,
    "MotorcycleIntervalSeconds": 5,
    "PortableIntervalSeconds": 30,
    "FixedAssetIntervalSeconds": 300,
    "DroneIntervalSeconds": 1
  },

  "Notifications": {
    "Webhooks": {
      "TimestampToleranceMinutes": {
        "tracking-service": 5,
        "notification-service": 10,
        "route-optimization": 15
      },
      "TrackingService": {
        "Secret": "your-tracking-service-secret-key-change-in-production"
      },
      "NotificationService": {
        "Secret": "your-notification-service-secret-key-change-in-production"
      },
      "RouteOptimization": {
        "Secret": "your-route-optimization-secret-key-change-in-production"
      }
    }
  }
}